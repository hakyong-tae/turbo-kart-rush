{
  "name": "drift-dash-gp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DRIFT KART - arcade kart racer built with Three.js (based on Turbo Kart Rush, MIT). Fully procedural: no external assets. Verse8 edition with online multiplayer.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:crazygames": "vite build --mode crazygames",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agent8/gameserver": "^1.10.2",
    "@verse8/ads": "^0.5.1",
    "@verse8/platform": "^2.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
